# Server only. Copy values from the existing Feishu developer application.
# Never commit the filled-in file or copy these variables into an APK/web page.
OOPS_FEISHU_CLIENT_ID=
OOPS_FEISHU_CLIENT_SECRET=
# Must exactly match the registered HTTPS redirect URI (including proxy prefix).
OOPS_FEISHU_REDIRECT_URI=
# Fernet key generated by cryptography, kept outside the backend data directory.
OOPS_FEISHU_TOKEN_KEY=
# Space-separated, approved USER scopes: reviewed minutes delivery + task create/read-back.
# No contacts, email, phone, calendar, or Base permission is needed for this flow.
# Remove task:task:write when task creation is disabled. offline_access enables refresh.
# The code's unconfigured default remains offline_access only; this is the deployment example.
OOPS_FEISHU_OAUTH_SCOPES="offline_access docx:document:create docx:document:write_only docs:permission.setting:read docs:permission.setting:write_only docs:permission.member:create drive:drive.metadata:readonly im:message im:message.send_as_user task:task:write"
