[Unit]
Description=Remove revoked Oops reanalysis copies and retain numeric cost receipts
After=oops-backend.service

[Service]
Type=oneshot
User=oops
Group=oops
WorkingDirectory=/opt/oops/history
Environment=PYTHONPATH=/opt/oops/app/scripts
ExecStart=/opt/oops/venv/bin/python -B /opt/oops/history/scripts/replay_history.py cleanup-reanalyses --state-dir /var/lib/oops/backend --reanalyses-dir /var/lib/oops-history/reanalyses --jobs-dir /var/lib/oops-history/reanalysis-jobs --receipts-dir /var/lib/oops-history/reanalysis-receipts
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/oops/backend
ReadWritePaths=/var/lib/oops-history
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
TimeoutStartSec=30
